  "hediet.vscode-drawio.resizeImages": null,
  "hediet.vscode-drawio.appearance": "automatic",
  "hediet.vscode-drawio.defaultEdgeStyle": {
    "fontSize": 14,
    "fontFamily": "Noto Sans CJK SC",
  },
  "hediet.vscode-drawio.defaultVertexStyle": {
    "fontSize": 14,
    "fontFamily": "Noto Sans CJK SC",
  },
  // ---- Hex Editor ----
  "hexeditor.columnWidth": 32,
  "hexeditor.showDecodedText": true,
  "hexeditor.defaultEndianness": "little",
  "hexeditor.inspectorType": "aside",
  // ---- Git / GitLens ----
  "gitlens.views.scm.grouped.views": {
    "commits": true,
    "branches": true,
    "remotes": true,
    "stashes": true,
    "tags": true,
    "worktrees": true,
    "contributors": true,
    "fileHistory": true,
    "repositories": true,
    "searchAndCompare": false,
    "launchpad": true,
  },
  "gitlens.codeLens.authors.enabled": false,
  "gitlens.graph.minimap.additionalTypes": ["stashes", "localBranches"],
  "gitlens.graph.statusBar.enabled": false,
  "gitlens.graph.details.location": "auto",
  "gitlens.graph.changesColumn.enabled": true,
  "git.openRepositoryInParentFolders": "never",
  "git.autofetch": true,
  // ---- LeetCode ----
  "leetcode.endpoint": "leetcode-cn",
  "intellij.region": "china",
  "intellij.dataSharing": "none",
  "resharper.region.region": "China",
  "resharper.dataSharing.allowDataSharing": false,
}
