  ],
  // ===================================================
  // Typst
  // ===================================================
  "tinymist.formatterMode": "typstyle",
  // "tinymist.previewer": "myriad-dreamin.tinymist-gpu-viewer",
  // "tinymist.gpuViewer.windowLayout": "disabled",
  "tinymist.lint.enabled": true,
